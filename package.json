  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "babel-core": "^6.26.3",
    "babel-preset-env": "^1.7.0",
    "cssnano": "^7.0.7",
    "cypress": "^14.4.1",
    "eslint": "^8.57.1",
    "grunt": "^1.6.1",
    "grunt-babel": "^8.0.0",
    "grunt-contrib-qunit": "^10.1.1",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-eslint": "^25.0.0",
